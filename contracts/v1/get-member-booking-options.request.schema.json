{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gainpath.local/contracts/v1/get-member-booking-options.request.schema.json",
  "title": "Member booking options request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "organizationId", "coachId", "durationMinutes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "organizationId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
    "coachId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
    "localDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "durationMinutes": { "enum": [30, 60] }
  }
}
