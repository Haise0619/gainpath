{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Trusted Sandbox booking payment state v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "amountMinor",
    "currency",
    "coachName",
    "branchName",
    "durationMinutes",
    "bookingId",
    "status",
    "startLabel",
    "endLabel",
    "localDate",
    "holdExpiresAtMillis"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "amountMinor": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000000
    },
    "currency": {
      "const": "MYR"
    },
    "coachName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "branchName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "durationMinutes": {
      "enum": [
        30,
        60
      ]
    },
    "bookingId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "status": {
      "enum": [
        "creating",
        "awaiting_payment",
        "confirmed",
        "reconciliation_required"
      ]
    },
    "startLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "endLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "localDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "holdExpiresAtMillis": {
      "type": "integer",
      "minimum": 1
    },
    "checkoutUrl": {
      "type": "string",
      "pattern": "^https://(www\\.)?billplz-sandbox\\.com/"
    },
    "resolutionReason": {
      "type": "string",
      "maxLength": 80
    }
  }
}
