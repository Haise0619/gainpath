{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gainpath.local/contracts/v1/create-booking-hold.request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "organizationId",
    "memberId",
    "branchId",
    "coachId",
    "startAtMillis",
    "durationMinutes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "organizationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "memberId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "branchId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "coachId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "startAtMillis": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8639999996400000
    },
    "durationMinutes": {
      "enum": [
        30,
        60
      ]
    }
  }
}
