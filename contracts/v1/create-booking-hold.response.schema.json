{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gainpath.local/contracts/v1/create-booking-hold.response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "bookingId",
    "status",
    "holdExpiresAtMillis"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "bookingId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "status": {
      "const": "pending_hold"
    },
    "holdExpiresAtMillis": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8639999996400000
    }
  }
}
