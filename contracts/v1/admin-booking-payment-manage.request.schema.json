{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "organizationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "bookingId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "action": {
      "enum": [
        "verify",
        "recover_bill",
        "approve_refund",
        "reject_refund",
        "execute_refund",
        "check_refund",
        "recover_refund"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 5,
      "maxLength": 500
    },
    "billId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "refundOrderId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": [
    "schemaVersion",
    "organizationId",
    "bookingId",
    "requestId",
    "action"
  ]
}
