{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gainpath.local/contracts/v1/booking-policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyVersion",
    "timeZone",
    "maxActiveBookingsPerMemberPerDay",
    "holdMinutes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "policyVersion": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "timeZone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "maxActiveBookingsPerMemberPerDay": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "holdMinutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    }
  }
}
