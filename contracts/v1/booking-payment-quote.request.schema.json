{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Authoritative booking payment quote request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "organizationId",
    "coachId",
    "branchId",
    "durationMinutes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "organizationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "coachId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "branchId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "durationMinutes": {
      "enum": [
        30,
        60
      ]
    }
  }
}
