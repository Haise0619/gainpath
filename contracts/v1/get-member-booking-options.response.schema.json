{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gainpath.local/contracts/v1/get-member-booking-options.response.schema.json",
  "title": "Member booking options response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "coachId", "durationMinutes", "serverNowMillis", "todayLocalDate", "localDate", "timeZone", "throughLocalDate", "permittedBranchIds", "options"],
  "definitions": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
    "time": { "type": "integer", "minimum": 1, "maximum": 8639999996400000 },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "label": { "type": "string", "minLength": 1, "maxLength": 80 }
  },
  "properties": {
    "schemaVersion": { "const": 1 },
    "coachId": { "$ref": "#/definitions/id" },
    "durationMinutes": { "enum": [30, 60] },
    "serverNowMillis": { "$ref": "#/definitions/time" },
    "todayLocalDate": { "$ref": "#/definitions/date" },
    "localDate": { "$ref": "#/definitions/date" },
    "throughLocalDate": { "$ref": "#/definitions/date" },
    "timeZone": { "type": "string", "minLength": 1, "maxLength": 100 },
    "permittedBranchIds": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "$ref": "#/definitions/id" } },
    "options": {
      "type": "array", "maxItems": 52,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["branchId", "startAtMillis", "endAtMillis", "startLabel", "endLabel"],
        "properties": {
          "branchId": { "$ref": "#/definitions/id" },
          "startAtMillis": { "$ref": "#/definitions/time" },
          "endAtMillis": { "$ref": "#/definitions/time" },
          "startLabel": { "$ref": "#/definitions/label" },
          "endLabel": { "$ref": "#/definitions/label" }
        }
      }
    },
    "unavailableReason": { "enum": ["no_open_times", "daily_limit"] }
  },
  "allOf": [{
    "if": { "properties": { "options": { "type": "array", "maxItems": 0 } } },
    "then": { "required": ["unavailableReason"] },
    "else": { "not": { "required": ["unavailableReason"] } }
  }]
}
