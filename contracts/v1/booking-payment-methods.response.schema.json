{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Enabled Sandbox methods or original invoice",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "serverNowMillis",
    "methods"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "serverNowMillis": {
      "type": "integer",
      "minimum": 1
    },
    "methods": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "name",
          "category"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "category": {
            "enum": [
              "fpx",
              "billplz"
            ]
          }
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "amountMinor",
        "currency",
        "coachName",
        "branchName",
        "durationMinutes",
        "localDate",
        "startLabel",
        "endLabel",
        "holdExpiresAtMillis"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "amountMinor": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "currency": {
          "const": "MYR"
        },
        "coachName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "branchName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "durationMinutes": {
          "enum": [
            30,
            60
          ]
        },
        "localDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "startLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "endLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "holdExpiresAtMillis": {
          "type": "integer",
          "minimum": 1
        },
        "quoteToken": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "existingPayment": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Trusted Sandbox booking payment state v1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "amountMinor",
        "currency",
        "coachName",
        "branchName",
        "durationMinutes",
        "bookingId",
        "status",
        "startLabel",
        "endLabel",
        "localDate",
        "holdExpiresAtMillis"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "amountMinor": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "currency": {
          "const": "MYR"
        },
        "coachName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "branchName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "durationMinutes": {
          "enum": [
            30,
            60
          ]
        },
        "bookingId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "status": {
          "enum": [
            "creating",
            "awaiting_payment",
            "confirmed",
            "reconciliation_required"
          ]
        },
        "startLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "endLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "localDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "holdExpiresAtMillis": {
          "type": "integer",
          "minimum": 1
        },
        "checkoutUrl": {
          "type": "string",
          "pattern": "^https://(www\\.)?billplz-sandbox\\.com/"
        },
        "resolutionReason": {
          "type": "string",
          "maxLength": 80
        },
        "paymentStatus": {
          "enum": [
            "pending",
            "cleared"
          ]
        },
        "refundStatus": {
          "enum": [
            "approved",
            "rejected",
            "processing",
            "uncertain",
            "completed",
            "failed"
          ]
        },
        "serverNowMillis": {
          "type": "integer",
          "minimum": 1
        },
        "gatewayCode": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "paymentMethodName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "selectedPaymentMethodCategory": {
          "enum": [
            "fpx",
            "ewallet",
            "card"
          ]
        },
        "selectedPaymentMethodCode": {
          "type": "string",
          "enum": [
            "maybank2u",
            "cimbclicks",
            "publicbank",
            "rhb",
            "hongleong",
            "bankislam",
            "ambank",
            "bsn",
            "affin",
            "alliance",
            "tng",
            "grabpay",
            "shopeepay",
            "visa_mastercard"
          ]
        },
        "selectedPaymentMethodLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "selectedPaymentMethodIconKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "selectedAt": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "selectionMethods": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "code",
          "name",
          "iconKey"
        ],
        "properties": {
          "category": {
            "enum": [
              "fpx",
              "ewallet",
              "card"
            ]
          },
          "code": {
            "type": "string",
            "enum": [
              "maybank2u",
              "cimbclicks",
              "publicbank",
              "rhb",
              "hongleong",
              "bankislam",
              "ambank",
              "bsn",
              "affin",
              "alliance",
              "tng",
              "grabpay",
              "shopeepay",
              "visa_mastercard"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "iconKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "required": [
        "session"
      ],
      "not": {
        "required": [
          "existingPayment"
        ]
      }
    },
    {
      "required": [
        "existingPayment"
      ],
      "not": {
        "required": [
          "session"
        ]
      },
      "properties": {
        "methods": {
          "maxItems": 0,
          "type": "array"
        }
      }
    }
  ]
}
