{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gainpath.local/contracts/v1/revoke-workout-consent.request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "organizationId",
    "memberId",
    "consentVersion",
    "acknowledgementId"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "requestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "organizationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "memberId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "consentVersion": {
      "const": "pose-local-summary-v1"
    },
    "acknowledgementId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    }
  }
}