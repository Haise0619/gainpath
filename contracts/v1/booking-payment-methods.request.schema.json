{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Booking Sandbox payment methods request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "organizationId",
    "bookingId"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "organizationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "bookingId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    }
  }
}
