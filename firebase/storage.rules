rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function activeMember(orgId) {
      return signedIn()
        && request.auth.token.email_verified == true
        && firestore.exists(/databases/(default)/documents/orgs/$(orgId)/members/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/orgs/$(orgId)/members/$(request.auth.uid)).data.status == 'active';
    }

    function staffForMember(orgId, uid) {
      return activeMember(orgId)
        && (firestore.get(/databases/(default)/documents/orgs/$(orgId)/members/$(request.auth.uid)).data.role == 'admin'
          || (firestore.get(/databases/(default)/documents/orgs/$(orgId)/members/$(request.auth.uid)).data.role == 'staff'
            && firestore.get(/databases/(default)/documents/orgs/$(orgId)/members/$(uid)).data.branchIds
              .hasAny(firestore.get(/databases/(default)/documents/orgs/$(orgId)/members/$(request.auth.uid)).data.branchIds)));
    }

    match /orgs/{orgId}/members/{uid}/{filePath=**} {
      allow read: if activeMember(orgId) && (request.auth.uid == uid || staffForMember(orgId, uid));
      allow write: if activeMember(orgId)
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
    }

    function memberSessionActive(uid) {
      let user = firestore.get(/databases/(default)/documents/users/$(uid)).data;
      return !('accountLifecycle' in user) || (user.accountLifecycle is map
        && user.accountLifecycle.schemaVersion == 1
        && user.accountLifecycle.state == 'active'
        && user.accountLifecycle.revision is int && user.accountLifecycle.revision >= 1
        && user.accountLifecycle.requestedAtMillis is int && user.accountLifecycle.requestedAtMillis > 0
        && user.accountLifecycle.sessionNotBeforeSeconds is int
        && user.accountLifecycle.sessionNotBeforeSeconds == int(user.accountLifecycle.requestedAtMillis / 1000) + 1
        && user.accountLifecycle.revocationPending == false
        && user.accountLifecycle.sessionRevokedAtMillis is int
        && user.accountLifecycle.sessionRevokedAtMillis >= user.accountLifecycle.requestedAtMillis
        && user.accountLifecycle.reactivatedAtMillis is int
        && user.accountLifecycle.reactivatedAtMillis >= user.accountLifecycle.sessionRevokedAtMillis
        && request.auth.token.auth_time is int
        && request.auth.token.auth_time >= user.accountLifecycle.sessionNotBeforeSeconds);
    }

    // FR-1.7: private immutable Member photo objects; clearing removes only the reference.
    match /orgs/{orgId}/memberProfilePhotos/{ownerUid}/{imageId} {
      function memberPhotoOwner() {
        return request.auth != null && request.auth.uid == ownerUid
          && request.auth.token.email_verified == true
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.organizationId == orgId
          && firestore.get(/databases/(default)/documents/orgs/$(orgId)/members/$(request.auth.uid)).data.organizationId == orgId
          && firestore.get(/databases/(default)/documents/orgs/$(orgId)/members/$(request.auth.uid)).data.status == 'active'
          && firestore.get(/databases/(default)/documents/orgs/$(orgId)/members/$(request.auth.uid)).data.role == 'member'
          && memberSessionActive(ownerUid);
      }
      allow get: if memberPhotoOwner();
      allow create: if memberPhotoOwner() && resource == null
        && imageId.matches('[a-f0-9]{32}')
        && request.resource.size > 0 && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
      allow update, delete, list: if false;
    }

    // Private Admin profile photos only. Existing Storage permissions stay unchanged.
    match /orgs/{orgId}/profilePhotos/{ownerUid}/{imageId} {
      function profilePhotoOwner() {
        return request.auth != null
          && request.auth.uid == ownerUid
          && request.auth.token.email_verified == true
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.organizationId == orgId
          && firestore.get(/databases/(default)/documents/orgs/$(orgId)/members/$(request.auth.uid)).data.organizationId == orgId
          && firestore.get(/databases/(default)/documents/orgs/$(orgId)/members/$(request.auth.uid)).data.status == 'active'
          && firestore.get(/databases/(default)/documents/orgs/$(orgId)/members/$(request.auth.uid)).data.role == 'admin';
      }
      allow get: if profilePhotoOwner();
      allow create: if profilePhotoOwner() && resource == null
        && imageId.matches('[a-f0-9]{32}')
        && request.resource.size > 0 && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
      allow update, delete, list: if false;
    }

    // Equipment photos only. Existing member/content contracts remain unchanged.
    match /orgs/{orgId}/equipmentImages/{uploaderUid}/{imageId} {
      function currentEquipmentMember() {
        return request.auth != null
          && request.auth.token.email_verified == true
          && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.organizationId == orgId
          && firestore.get(/databases/(default)/documents/orgs/$(orgId)/members/$(request.auth.uid)).data.organizationId == orgId
          && firestore.get(/databases/(default)/documents/orgs/$(orgId)/members/$(request.auth.uid)).data.status == 'active';
      }
      allow get: if currentEquipmentMember();
      allow create: if currentEquipmentMember()
        && resource == null
        && request.auth.uid == uploaderUid
        && firestore.get(/databases/(default)/documents/orgs/$(orgId)/members/$(request.auth.uid)).data.role in ['admin', 'staff']
        && request.resource.size > 0 && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
      allow update, delete, list: if false;
    }

    match /orgs/{orgId}/content/{filePath=**} {
      allow read: if activeMember(orgId);
      // Publication and media validation belong to trusted content commands.
      allow write: if false;
    }
  }
}
